<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Search Launcher</title>
  <name>SearchLauncher</name>
  <fname>search-launcher</fname>
  <desc>Search Launcher to launch the search portlet that searches the portal, directory, and campus web.</desc>
  <type>Web Component</type>
  <timeout>30000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>WebComponent</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <group>Everyone</group>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/actions/system-search.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/search.png</value>
  </parameter>
  <parameter>
    <name>role</name>
    <value>searchLauncher</value>
  </parameter>
  <parameter>
    <name>webComponent.attributes</name>
    <value>search-fname=search</value>
  </parameter>
  <parameter>
    <name>webComponent.moduleUrl</name>
    <value>up-search</value>
  </parameter>
  <parameter>
    <name>webComponent.tagName</name>
    <value>up-search-launcher</value>
  </parameter>
</portlet-definition>
