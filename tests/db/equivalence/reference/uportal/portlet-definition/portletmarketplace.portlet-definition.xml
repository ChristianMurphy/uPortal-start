<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Portlet Marketplace</title>
  <name>Portlet Marketplace</name>
  <fname>portletmarketplace</fname>
  <desc>Browse and add portlets</desc>
  <type>Portlet</type>
  <timeout>50000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>PortletMarketplace</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Featured</category>
  <category>uPortal</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/categories/preferences-system.png</value>
  </parameter>
  <portlet-preference>
    <name>Release_Date</name>
    <readOnly>true</readOnly>
    <value>2014-09-13 12:00:00</value>
  </portlet-preference>
  <portlet-preference>
    <name>Release_Notes</name>
    <readOnly>true</readOnly>
    <value>Responsive Design!</value>
    <value>Doesn't Break</value>
    <value>Adds the ability to have Screenshots</value>
    <value>Adds the ability for version notes</value>
    <value>Search works</value>
    <value>See your favorite apps</value>
  </portlet-preference>
  <portlet-preference>
    <name>screen_shot1</name>
    <readOnly>true</readOnly>
    <value>http://image.shutterstock.com/display_pic_with_logo/427597/141533524/stock-photo-marketplace-road-sign-141533524.jpg</value>
  </portlet-preference>
  <portlet-preference>
    <name>screen_shot1_caption</name>
    <readOnly>true</readOnly>
    <value>The really cool marketplace</value>
  </portlet-preference>
  <portlet-preference>
    <name>screen_shot2</name>
    <readOnly>true</readOnly>
    <value>http://thumb7.shutterstock.com/display_pic_with_logo/248635/135897425/stock-photo-a-vending-machine-with-the-words-buy-apps-here-and-many-app-tiles-and-icons-ready-to-be-bought-and-135897425.jpg</value>
  </portlet-preference>
  <portlet-preference>
    <name>screen_shot2_caption</name>
    <readOnly>true</readOnly>
    <value>One Stop Shopping</value>
  </portlet-preference>
  <portlet-preference>
    <name>short_link</name>
    <readOnly>true</readOnly>
    <value>http://goo.gl/ALBYpJ</value>
  </portlet-preference>
  <portlet-preference>
    <name>showRootCategory</name>
    <readOnly>true</readOnly>
    <value>false</value>
  </portlet-preference>
</portlet-definition>
