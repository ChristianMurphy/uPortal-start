<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Reset My Layout</title>
  <name>Reset My Layout</name>
  <fname>reset-my-layout</fname>
  <desc>Provides a means to reset your own layout to its default settings. Also deletes all portlet preference values.</desc>
  <type>Portlet</type>
  <timeout>50000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>ResetMyLayout</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Administration</category>
  <category>Quicklinks</category>
  <group>Authenticated Users</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Authenticated Users</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/actions/view-refresh.png</value>
  </parameter>
</portlet-definition>
