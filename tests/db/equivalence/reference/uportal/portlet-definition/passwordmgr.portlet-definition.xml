<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Password Management</title>
  <name>Password Management</name>
  <fname>passwordmgr</fname>
  <desc>Allows management of passwords.</desc>
  <type>Web Component</type>
  <timeout>50000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>WebComponent</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>uPortal</category>
  <group>Authenticated Users</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Authenticated Users</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/categories/preferences-system.png</value>
  </parameter>
  <parameter>
    <name>webComponent.moduleUrl</name>
    <value>up-self-edit-account</value>
  </parameter>
  <parameter>
    <name>webComponent.tagName</name>
    <value>up-self-edit-account</value>
  </parameter>
</portlet-definition>
