<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Word of the Day</title>
  <name>Word of the Day</name>
  <fname>word-of-the-day</fname>
  <desc>Dictonary.com Word of the Day</desc>
  <type>RSS</type>
  <timeout>10000</timeout>
  <portlet-descriptor>
    <up:webAppName>/NewsReaderPortlet</up:webAppName>
    <up:portletName>news</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Entertainment</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/apps/internet-news-reader.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/news.png</value>
  </parameter>
  <portlet-preference>
    <name>Whitelist.regexValues</name>
    <readOnly>false</readOnly>
    <value>sfn-wotd</value>
  </portlet-preference>
  <portlet-preference>
    <name>summaryView</name>
    <readOnly>false</readOnly>
    <value>full</value>
  </portlet-preference>
</portlet-definition>
