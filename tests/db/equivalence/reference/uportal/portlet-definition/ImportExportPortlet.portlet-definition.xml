<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Import Export Portlet</title>
  <name>Import Export Portlet</name>
  <fname>ImportExportPortlet</fname>
  <desc>Import or export portal objects through the browser</desc>
  <type>Portlet</type>
  <timeout>50000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>ImportExportPortlet</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Administration</category>
  <category>Development</category>
  <group>Portal Administrators</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Portal Administrators</group>
    </permission>
  </permissions>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>false</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/actions/go-top.png</value>
  </parameter>
</portlet-definition>
