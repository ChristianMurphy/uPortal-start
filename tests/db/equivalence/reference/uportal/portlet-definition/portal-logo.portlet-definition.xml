<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Portal Logo</title>
  <name>Portal Logo</name>
  <fname>portal-logo</fname>
  <desc>Renders the portal logo at the top of the page</desc>
  <type>Portlet</type>
  <timeout>5000</timeout>
  <portlet-descriptor>
    <up:webAppName>/SimpleContentPortlet</up:webAppName>
    <up:portletName>cms</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <group>Everyone</group>
  <parameter>
    <name>configurable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <portlet-preference>
    <name>content</name>
    <readOnly>false</readOnly>
    <value>\n            \n                &lt;h1 class="portal-logo"&gt;&lt;a href='/uPortal'&gt;uPortal&lt;/a&gt;&lt;/h1&gt;\n            \n        </value>
  </portlet-preference>
</portlet-definition>
