<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Movies.com Movie News</title>
  <name>Movies.com Movie News</name>
  <fname>movie-news</fname>
  <desc>Check out exclusive movie news only at Movies.com</desc>
  <type>RSS</type>
  <timeout>10000</timeout>
  <portlet-descriptor>
    <up:webAppName>/NewsReaderPortlet</up:webAppName>
    <up:portletName>news</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Entertainment</category>
  <category>Quicklinks</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>editable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>hasHelp</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/mimetypes/video-x-generic.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/feed.png</value>
  </parameter>
  <portlet-preference>
    <name>Whitelist.regexValues</name>
    <readOnly>false</readOnly>
    <value>sfn-movie-news</value>
  </portlet-preference>
  <portlet-preference>
    <name>summaryView</name>
    <readOnly>false</readOnly>
    <value>flyout</value>
  </portlet-preference>
</portlet-definition>
