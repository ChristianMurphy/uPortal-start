<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Portlet CAS Test</title>
  <name>Portlet CAS Test</name>
  <fname>portlet-cas-test</fname>
  <desc>Tests uPortal's ability to pass a valid CAS ticket to a portlet through the UserInfo map.</desc>
  <type>Portlet</type>
  <timeout>60000</timeout>
  <portlet-descriptor>
    <up:webAppName>/cas-proxy-test-portlet</up:webAppName>
    <up:portletName>ProxyCasTest</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Development</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/categories/applications-development.png</value>
  </parameter>
</portlet-definition>
