<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>The Chronicle: Wired Campus</title>
  <name>The Chronicle: Wired Campus</name>
  <fname>chronicle-wired</fname>
  <desc>Top stories from The Chronicle of Higher Education: Wired Campus Edition</desc>
  <type>RSS</type>
  <timeout>5000</timeout>
  <portlet-descriptor>
    <up:webAppName>/NewsReaderPortlet</up:webAppName>
    <up:portletName>news</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Entertainment</category>
  <category>News</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>editable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>hasHelp</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/apps/internet-news-reader.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/feed.png</value>
  </parameter>
  <portlet-preference>
    <name>Whitelist.regexValues</name>
    <readOnly>false</readOnly>
    <value>sfn-chronicle-wired</value>
  </portlet-preference>
  <portlet-preference>
    <name>summaryView</name>
    <readOnly>false</readOnly>
    <value>flyout</value>
  </portlet-preference>
</portlet-definition>
