<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Error</title>
  <name>Error</name>
  <fname>error</fname>
  <desc>Displays an error message when the original portlet failed to render.</desc>
  <type>Portlet</type>
  <timeout>30000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>Error</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <group>Everyone</group>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/status/dialog-warning.png</value>
  </parameter>
</portlet-definition>
