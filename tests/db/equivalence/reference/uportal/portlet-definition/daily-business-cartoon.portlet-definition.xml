<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Daily Business Cartoon</title>
  <name>Daily Business Cartoon</name>
  <fname>daily-business-cartoon</fname>
  <desc>Daily Business Cartoon by Ted Goff, www.tedgoff.com</desc>
  <type>Image</type>
  <timeout>30000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>Image</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Entertainment</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>editable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>hasHelp</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/emotes/face-smile.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/feed.png</value>
  </parameter>
  <portlet-preference>
    <name>img-border</name>
    <readOnly>false</readOnly>
    <value>0</value>
  </portlet-preference>
  <portlet-preference>
    <name>img-height</name>
    <readOnly>false</readOnly>
    <value>300</value>
  </portlet-preference>
  <portlet-preference>
    <name>img-link</name>
    <readOnly>false</readOnly>
    <value>http://www.tedgoff.com</value>
  </portlet-preference>
  <portlet-preference>
    <name>img-uri</name>
    <readOnly>false</readOnly>
    <value>http://www.tedgoff.com/mb/images/today.gif</value>
  </portlet-preference>
  <portlet-preference>
    <name>img-width</name>
    <readOnly>false</readOnly>
    <value>300</value>
  </portlet-preference>
</portlet-definition>
