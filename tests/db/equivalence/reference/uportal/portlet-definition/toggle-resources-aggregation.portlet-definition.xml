<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Toggle Resources Aggregation</title>
  <name>Toggle Resources Aggregation</name>
  <fname>toggle-resources-aggregation</fname>
  <desc>Provides a means to enable/disable CSS and JavaScript aggregation.</desc>
  <type>Portlet</type>
  <timeout>30000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>ToggleResourcesAggregation</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Administration</category>
  <category>Development</category>
  <group>Portal Administrators</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Portal Administrators</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/categories/preferences-desktop.png</value>
  </parameter>
</portlet-definition>
