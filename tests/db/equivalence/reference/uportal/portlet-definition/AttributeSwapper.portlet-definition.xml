<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Attribute Swapper</title>
  <name>Attribute Swapper</name>
  <fname>AttributeSwapper</fname>
  <desc>Change the values of your user attributes in real time</desc>
  <type>Portlet</type>
  <timeout>600000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>AttributeSwapperPortlet</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Administration</category>
  <group>Portal Administrators</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Portal Administrators</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/status/software-update-available.png</value>
  </parameter>
</portlet-definition>
