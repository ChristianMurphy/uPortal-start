<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>uPortal Links</title>
  <name>uPortal Links</name>
  <fname>uportal-links</fname>
  <desc>Useful uPortal links.</desc>
  <type>CMS</type>
  <timeout>10000</timeout>
  <portlet-descriptor>
    <up:webAppName>/SimpleContentPortlet</up:webAppName>
    <up:portletName>cms</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>News</category>
  <category>Quicklinks</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>configurable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/mimetypes/text-html.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/links.png</value>
  </parameter>
  <portlet-preference>
    <name>content</name>
    <readOnly>false</readOnly>
    <value>\n        \n                &lt;h2&gt;uPortal Links&lt;/h2&gt;\n                &lt;ul&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/uportal"&gt;uPortal Home&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="https://uPortal-Project.github.io/uPortal/"&gt;uPortal 5 Documentation&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/uportal/download"&gt;Download uPortal&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://wiki.jasig.org/display/UPC/Home"&gt;uPortal Wiki&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/uportal/mailing-lists"&gt;Join mailing lists&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/content/member-organizations"&gt;Become an Apereo Foundation member&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/uportal/support/solutions-providers"&gt;uPortal commercial services and support&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/content/apereo-newsletters"&gt;Apereo newsletter&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://www.apereo.org/uportal/deployments"&gt;uPortal-driven sites&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="http://issues.jasig.org/browse/UP"&gt;uPortal Issue Tracker&lt;/a&gt;&lt;/li&gt;\n                    &lt;li&gt;&lt;a target="_blank" href="https://wiki.jasig.org/display/PLT/Home"&gt;Browse additional portlets&lt;/a&gt;&lt;/li&gt;\n                &lt;/ul&gt;\n        \n        </value>
  </portlet-preference>
</portlet-definition>
