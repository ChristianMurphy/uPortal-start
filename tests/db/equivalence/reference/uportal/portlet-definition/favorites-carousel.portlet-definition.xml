<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Favorites Carousel</title>
  <name>Favorites Carousel</name>
  <fname>favorites-carousel</fname>
  <desc>A carousel of portlets in the user's collection of favorites</desc>
  <type>Advanced CMS</type>
  <timeout>5000</timeout>
  <portlet-descriptor>
    <up:webAppName>/SimpleContentPortlet</up:webAppName>
    <up:portletName>cms</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <group>Everyone</group>
  <parameter>
    <name>blockImpersonation</name>
    <value>false</value>
  </parameter>
  <parameter>
    <name>chromeStyle</name>
    <value>no-chrome</value>
  </parameter>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>editable</name>
    <value>false</value>
  </parameter>
  <parameter>
    <name>hasAbout</name>
    <value>false</value>
  </parameter>
  <parameter>
    <name>hasHelp</name>
    <value>false</value>
  </parameter>
  <parameter>
    <name>hideFromMobile</name>
    <value>false</value>
  </parameter>
  <portlet-preference>
    <name>content</name>
    <readOnly>false</readOnly>
    <value>\n            \n                &lt;script src="/resource-server/webjars/vue/dist/vue.min.js"&gt;&lt;/script&gt;\n                &lt;script src="/resource-server/webjars/uportal__content-carousel/dist/content-carousel.min.js" defer&gt;&lt;/script&gt;\n                &lt;content-carousel\n                        type="portlet"\n                        source="/uPortal/api/v4-3/dlm/portletRegistry.json?favorite=true"\n                        slick-options='{ "slidesToShow": 6, "infinite": true, "arrows": true, "dots": true }'&gt;\n                    &lt;h3 slot="header"&gt;Favorites&lt;/h3&gt;\n                    &lt;div slot="empty"&gt;\n                        &lt;h4&gt;You don't have any favorites yet!&lt;/h4&gt;\n                        &lt;p&gt;Use "Options &amp;gt; Add to my favorites" to organize content here.&lt;/p&gt;\n                    &lt;/div&gt;\n                &lt;/content-carousel&gt;\n            \n        </value>
  </portlet-preference>
</portlet-definition>
