<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Who's Online</title>
  <name>Who's Online</name>
  <fname>whos-online</fname>
  <desc>Mockup of a Who's Online portlet.</desc>
  <type>CMS</type>
  <timeout>10000</timeout>
  <portlet-descriptor>
    <up:webAppName>/SimpleContentPortlet</up:webAppName>
    <up:portletName>cms</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Information</category>
  <group>Everyone</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Everyone</group>
    </permission>
  </permissions>
  <parameter>
    <name>configurable</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>disableDynamicTitle</name>
    <value>true</value>
  </parameter>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/mimetypes/text-html.png</value>
  </parameter>
  <parameter>
    <name>mobileIconUrl</name>
    <value>/uPortal/media/skins/icons/mobile/user_search.png</value>
  </parameter>
  <portlet-preference>
    <name>content</name>
    <readOnly>false</readOnly>
    <value>\n            \n                &lt;img src="/uPortal/media/org/jasig/portal/channels/webproxy/whosonline.png" \n                alt="uP3 Mock My Courses" border="0" /&gt;\n                \n                &lt;p&gt;Mock of Who's Online.  This is a sample screen for \n                demonstration purposes only.&lt;/p&gt;\n                \n            \n        </value>
  </portlet-preference>
</portlet-definition>
