<portlet-definition version="5.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/portlet-definition https://source.jasig.org/schemas/uportal/io/portlet-definition/portlet-definition-5.0.xsd">
  <title>Fragment Administration</title>
  <name>Fragment Administration</name>
  <fname>fragment-admin</fname>
  <desc>Portlet for Fragment Administration in the header</desc>
  <type>Portlet</type>
  <timeout>50000</timeout>
  <portlet-descriptor>
    <up:isFramework>true</up:isFramework>
    <up:portletName>FragmentAdministration</up:portletName>
  </portlet-descriptor>
  <lifecycle>
    <entry name="PUBLISHED" user="system">‹masked›</entry>
  </lifecycle>
  <category>Administration</category>
  <group>Portal Administrators</group>
  <group>Tenant Administrators</group>
  <permissions>
    <permission activity="BROWSE" system="UP_PORTLET_SUBSCRIBE">
      <group>Portal Administrators</group>
      <group>Tenant Administrators</group>
    </permission>
  </permissions>
  <parameter>
    <name>iconUrl</name>
    <value>/resource-server/rs/tango/0.8.90/32x32/apps/preferences-desktop-locale.png</value>
  </parameter>
</portlet-definition>
