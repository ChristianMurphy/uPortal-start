<pags-group script="classpath://org/jasig/portal/io/import-pags-group_v4-1.crn">
  <name>Mobile Device Access</name>
  <description>User Access by a mobile device</description>
  <selection-test>
    <test-group>
      <test>
        <attribute-name>agentDevice</attribute-name>
        <tester-class>org.apereo.portal.groups.pags.testers.PropertyRegexTester</tester-class>
        <test-value>org.apereo.portal.http.header.userAgent.mobile.regex.pattern</test-value>
      </test>
    </test-group>
  </selection-test>
</pags-group>
