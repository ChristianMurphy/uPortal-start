<?xml version="1.0" encoding="UTF-8"?>
<!--
 | Migration-equivalence fixture: a permission owner of its own, with Unicode names and
 | descriptions, so a permission set can name an owner and activity that uPortal does not ship.
 +-->
<permission-owner xmlns="https://source.jasig.org/schemas/uportal/io/permission-owner" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4.0" xsi:schemaLocation="https://source.jasig.org/schemas/uportal/io/permission-owner https://source.jasig.org/schemas/uportal/io/permission-owner/permission-owner-4.0.xsd">
    <name>Fixture Owner — Ünïcödé</name>
    <fname>FIXTURE_OWNER</fname>
    <desc>Permissions défined by the migration-equivalence fixture 🔐</desc>
    <activity>
        <name>Fixture Activity</name>
        <fname>FIXTURE_ACT</fname>
        <desc>Durchführen ✓</desc>
        <targetProvider>allGroupsTargetProvider</targetProvider>
    </activity>
    <activity>
        <name>Second Activity</name>
        <fname>FIXTURE_ACT_2</fname>
        <desc></desc>
        <targetProvider>peopleAndGroupsTargetProvider</targetProvider>
    </activity>
</permission-owner>
