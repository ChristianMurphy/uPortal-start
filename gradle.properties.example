version=5.0.0-SNAPSHOT

# Versions of Bundled Applications under `overlays/`
announcementsPortletVersion=2.5.3
basicltiPortletVersion=1.5.1
bookmarksPortletVersion=1.3.1
calendarPortletVersion=2.7.4
casProxyTestPortletVersion=1.0.2
esupFilemanagerPortletVersion=4.0.0
feedbackPortletVersion=1.3.2
newsReaderPortletVersion=5.1.5
notificationPortletVersion=4.8.4
# Required for very old front-end dependencies
resourceServerVersion=1.0.48
# Includes newer front-end dependencies and web components
resourceServerWebjarVersion=1.5.3
simpleContentPortletVersion=3.4.4
uPortalVersion=5.17.9
webProxyPortletVersion=2.4.1

# Versions of WebJars included with resource-server
vueVersion=2.7.16
uPortalWebComponentsVersion=1.40.1
notificationWebComponentsVersion=1.0.4
# 4.22.1 is the last truly free CKEditor 4 (4.23+ are LTS requiring a
# paid license key — they self-destruct on init without one). Latest CVE
# patches for 4.x require that license. See the ledger row for the long-
# term plan (CKEditor 5 migration vs replacement editor).
ckeditor4Version=4.22.1

# Dependencies driven by Tomcat version
tomcatVersion=9.0.122
servletApiDependency=javax.servlet:javax.servlet-api:4.0.1
jspApiVersion=2.3.3
elApiVersion=3.0.0
# JSTL packaged into every overlaid WAR that ships one (MOD-I60, see overlays/build.gradle)
taglibsStandardVersion=1.2.5
ccppVersion=1.0

# Dependencies driven by uPortal
personDirectoryVersion=1.8.16

# Dependencies driven by Pluto Portlet Engine version
plutoVersion=2.1.0-M3
portletApiDependency=org.apache.portals:portlet-api_2.1.0_spec:1.0

# Gradle Task Dependencies
asmVersion=9.11
junitJupiterVersion=5.13.4
gradleDockerPluginVersion=10.0.0
hsqldbVersion=2.7.4
jasyptVersion=1.9.3
nodejsVersion=24.11.1
waroverlayPluginVersion=0.9.3

# Dependencies used by overlays/ projects and custom code
# N.B. should be prefixed with an abbreviation if not for all projects (unlikely)

# Ports of the integrated Tomcat and HSQLDB (defaults shown).  Uncomment and change
# them, or pass e.g. -PtomcatHttpPort=8180, to run more than one portal on the
# same machine.  See "Running more than one portal" in README.md.
#tomcatHttpPort=8080
#tomcatShutdownPort=8005
#hsqlPort=8887

# How users sign in (docs/authentication.md):  local (uPortal's login form, the default) or cas.
# casServerUrl defaults to the development CAS server (./gradlew casStart) on casHttpPort.
#authMode=local
#casServerUrl=https://cas.example.edu/cas
#casHttpPort=8090

org.gradle.parallel=true

# These properties control image & version settings of Docker images built by the CLI.
# Customize the first in this file, and the second with a -P argument
# (e.g. $ ./gradlew dockerBuildImages -PdockerImageVersion=latest)
dockerImageBaseName=apereo/uportal
dockerImageVersion=latest
